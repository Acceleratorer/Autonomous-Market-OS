# Copy to /etc/autonomous-market-os/operator.env and chmod 600.
# Replace every REPLACE_* value before enabling the systemd units.
NODE_ENV=production
MARKET_OS_U55_MODE=1
MARKET_OS_TAILSCALE_OWNER_LOGIN=REPLACE_OWNER_TAILSCALE_LOGIN
MARKET_OS_TAILSCALE_HOSTNAME=REPLACE_VM_TAILNET_HOSTNAME
MARKET_OS_INTERNAL_ASSERTION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
MARKET_OS_ALLOWED_PORTFOLIO_ID=paper-main
MARKET_OS_PORT=8787
MARKET_OS_HOST=127.0.0.1
MARKET_OS_REQUEST_TIMEOUT=5
MARKET_OS_STORE_ROOT=/var/lib/autonomous-market-os/state
MARKET_OS_PORTFOLIO_ROOT=/var/lib/autonomous-market-os/portfolios
MARKET_OS_SESSION_STATE_PATH=/var/lib/autonomous-market-os/session/u5-5-jti.json
MARKET_OS_SERVICE_LOG=/var/log/autonomous-market-os/python.jsonl
MARKET_OS_API_PORT=8787

{
  "name": "market-os-electron-shell",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Local read-only Electron shell for the Market OS Next.js operator",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:headless": "electron . --disable-gpu --no-sandbox",
    "package:unsigned": "node scripts/package.cjs",
    "sign:artifact": "node scripts/sign-artifact.cjs",
    "release:drill": "node scripts/release-drill.cjs",
    "release:ci": "node scripts/ci-release.cjs",
    "install:preflight": "node scripts/install-preflight.cjs",
    "install:simulate": "node scripts/install-simulate.cjs",
    "install:portable": "node scripts/install-portable.cjs",
    "uninstall:portable": "node scripts/uninstall-portable.cjs",
    "runtime:prepare": "node scripts/prepare-python-runtime.cjs",
    "install:evidence": "node scripts/render-installation-evidence.cjs",
    "install:contract:validate": "node scripts/validate-installation-contract.cjs",
    "release:validate": "node scripts/validate-ci-evidence.cjs",
    "release:report": "node scripts/render-ci-evidence-report.cjs",
    "release:archive": "node scripts/archive-artifact.cjs",
    "release:index": "node scripts/index-portable-archives.cjs",
    "release:catalog": "node scripts/catalog-release.cjs",
    "release:catalog:report": "node scripts/render-release-catalog-report.cjs",
    "release:drift": "node scripts/audit-release-drift.cjs",
    "release:inspect": "node scripts/release-slots.cjs inspect",
    "release:promote": "node scripts/release-slots.cjs promote",
    "release:rollback": "node scripts/release-slots.cjs rollback",
    "smoke:artifact": "node scripts/smoke-artifact.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "electron": "45.3.0"
  }
}
